# Template only. Copy to .env.local and replace placeholders; never commit .env.local.
# Required: independent random AUTH_SECRET and AGENT_WEBHOOK_SECRET values, each >=32 chars.
AUTH_SECRET=replace-with-random-32-plus-character-secret
AGENT_WEBHOOK_SECRET=replace-with-a-different-random-32-plus-character-secret

# Optional, Testnet-only (default shown).
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
FASTNEAR_API_KEY=
NEXT_PUBLIC_DEFAULT_NEAR_ACCOUNT=agent-operator.testnet

# Optional unless a Supabase-backed feature is used. Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
