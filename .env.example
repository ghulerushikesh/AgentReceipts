# AgentReceipts local prototype configuration. Copy to .env.local and replace placeholders.
# Never use placeholder values in deployments.

# Required for staff session signing (generate a random value of at least 32 characters).
AUTH_SECRET=replace-with-random-32-plus-character-secret

# Required for agent events/connections API authentication (random 32+ characters).
AGENT_WEBHOOK_SECRET=replace-with-random-32-plus-character-secret

# Optional; defaults to the FastNear Testnet RPC. Only the listed Testnet hosts are accepted.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Optional FastNear API credential for higher request limits; server-side only.
FASTNEAR_API_KEY=

# Optional account to display; use a Testnet account.
NEXT_PUBLIC_DEFAULT_NEAR_ACCOUNT=agent-operator.testnet

# Optional Supabase configuration. Required only by features/routes that use Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
